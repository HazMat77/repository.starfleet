<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.starfleet"
       name="Starfleet Repository"
       version="1.0.11"
       provider-name="HazMat77">

  <requires>
    <import addon="xbmc.addon" version="12.0.0"/>
  </requires>

  <extension point="xbmc.addon.repository" name="Starfleet Repository">
    <dir>
      <info compressed="false">https://hazmat77.github.io/repository.starfleet/addons.xml</info>
      <checksum>https://hazmat77.github.io/repository.starfleet/addons.xml.md5</checksum>
      <datadir zip="true">https://hazmat77.github.io/repository.starfleet</datadir>
    </dir>
  </extension>

  <extension point="xbmc.addon.metadata">
    <assets>
      <icon>icon.png</icon>
    </assets>
    <summary lang="en">Starfleet Repository</summary>
    <description lang="en">
      Official repository for the Starfleet Kodi addon.
      Provides plugin.video.starfleet — TV Shows, Movies, Live TV,
      Sports, Free Streaming, Adult (PIN-protected), Radio.
    </description>
    <platform>all</platform>
    <license>GPL-2.0</license>
    <website>https://github.com/HazMat77/repository.starfleet</website>
    <source>https://github.com/HazMat77/repository.starfleet</source>
    <news>
      v1.0.11 - Remove Elementum localhost dir (caused repo check failure)
      v1.0.10 - Restore hazmat77.github.io CDN URLs
      v1.0.8 - Add Starfleet icon to repository
      v1.0.7 - Add Elementum/smrzips secondary repo dirs
    </news>
  </extension>

</addon>
