<?xml version="1.0" encoding="UTF-8"?>
<addons>

<addon id="repository.starfleet" name="Starfleet Repository" version="1.0.12" provider-name="HazMat77">
  <requires>
    <import addon="xbmc.addon" version="12.0.0" />
  </requires>
  <extension point="xbmc.addon.repository" name="Starfleet Repository">
    <dir>
      <info compressed="false">https://hazmat77.github.io/repository.starfleet/addons.xml</info>
      <checksum>https://hazmat77.github.io/repository.starfleet/addons.xml.md5</checksum>
      <datadir zip="true">https://hazmat77.github.io/repository.starfleet</datadir>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <assets>
      <icon>icon.png</icon>
    </assets>
    <summary lang="en">Starfleet Repository</summary>
    <description lang="en">Official repository for the Starfleet Kodi addon.</description>
    <platform>all</platform>
    <license>GPL-2.0</license>
  </extension>
</addon>

<addon id="plugin.video.starfleet" name="Starfleet" version="2.3.202" provider-name="HazMat77">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="script.module.requests" version="2.22.0" />
    <import addon="script.module.beautifulsoup4" version="4.6.0" />
    <import addon="inputstream.adaptive" version="2.6.0" optional="true" />
    <import addon="script.module.inputstreamhelper" version="0.5.9" optional="true" />
    <import addon="script.module.resolveurl" version="5.1.28" optional="true" />
    <import addon="plugin.video.elementum" version="0.1.113" optional="true" />
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video audio</provides>
    <reuselanguageinvoker>false</reuselanguageinvoker>
  </extension>
  <extension point="xbmc.addon.metadata">
    <assets>
      <icon>icon.png</icon>
    </assets>
    <summary lang="en">Starfleet - TV, Movies, Live TV, Sports, Radio, Adult</summary>
    <description lang="en">All-in-one Kodi plugin. TV, Movies, Live TV, Sports, Free Streaming, Adult (PIN-protected), Radio. Torrent/debrid sources via Real-Debrid, AllDebrid, Premiumize, TorBox. Elementum support for magnet playback.</description>
    <platform>all</platform>
    <license>GPL-2.0</license>
    <news>v2.3.202 - Clean shutdown fix; Kodi 21 InfoTagVideo API (no setInfo deprecation warnings)</news>
  </extension>
</addon>

<addon id="script.module.beautifulsoup4" name="BeautifulSoup4" version="4.15.0" provider-name="Leonard Richardson">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>
  <extension point="xbmc.python.module" library="lib" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en">Screen-scraping library</summary>
    <description lang="en">Beautiful Soup is a Python library for pulling data out of HTML and XML files.</description>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>

<addon id="plugin.video.elementum" name="Elementum" version="0.1.113" provider-name="elgatito">
  <requires>
    <import addon="xbmc.addon" version="16.0.0" />
    <import addon="script.module.requests" version="2.9.1" optional="true" />
  </requires>
  <extension point="xbmc.python.pluginsource" library="navigation.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.service" library="service.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en">Elementum: Media streaming</summary>
    <description lang="en">Torrent finding and streaming engine for Kodi.</description>
    <platform>all</platform>
    <license>Non commercial</license>
  </extension>
</addon>

</addons>
